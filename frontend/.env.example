# URL opcional del backend. Si se deja vacío, Vite usa el proxy de `/api`
# hacia http://127.0.0.1:8000.
# VITE_API_URL=http://127.0.0.1:8000

# Solo para el despliegue en Vercel. La función `api/[...path].js` la usa
# en el servidor para reenviar `/api` al backend público.
# No lleva prefijo VITE_: no se expone en el bundle del navegador.
# BACKEND_URL=https://tu-backend-publico
